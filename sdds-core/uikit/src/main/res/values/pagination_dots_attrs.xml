<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_paginationDotsStyle" format="reference" />

    <declare-styleable name="PaginationDots" sdds:api_info="PaginationDots"
        sdds:api_def_style_attr="sd_paginationDotsStyle"
        sdds:api_parent="Sdds.Components.PaginationDots" tools:ignore="ResourceName">
        <attr name="sd_gap" />

        <attr name="sd_itemCount" format="integer" />
        <attr name="sd_visibleItemCount" format="integer" />
        <attr name="sd_currentItem" format="integer" />

        <attr name="sd_dotWidth" format="dimension" />
        <attr name="sd_dotHeight" format="dimension" />

        <attr name="sd_edgeIndicatorCount" format="integer" sdds:api_name="edgeCount" />
        <attr name="sd_edgeIndicatorShrinkFactor" format="float" sdds:api_name="edgeShrinkFactor" />

        <attr name="sd_dotBackground" format="color|reference" sdds:api_name="dotBackgroundColor" sdds:api_res_suffix="dot_bg_color" sdds:api_type="color" />
        <attr name="android:orientation" sdds:api_type="value" sdds:api_name="orientation" />

    </declare-styleable>
</resources>