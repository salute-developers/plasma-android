<?xml version="1.0" encoding="utf-8"?>
<!-- Namespace sdds: размечает API компонента для генератора стилей.
     См. sdds-core/plugin_theme_builder/VIEW_STYLE_GENERATOR.md -->
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_iconButtonStyle" format="reference" />
    <attr name="sd_linkButtonStyle" format="reference" />
    <attr name="sd_buttonGroupStyle" format="reference" />

    <!--
        Компонент "Кнопка".
        Умеет отображать иконку, индикатор загрузки, а также два текста: основной и дополнительный.
      -->
    <declare-styleable name="Button" tools:ignore="ResourceName" sdds:api_info="BasicButton,IconButton,LinkButton"
        sdds:api_core_name="BasicButton=Button;IconButton=IconButton;LinkButton=LinkButton"
        sdds:api_color_state_scope="IconButton=variety"
        sdds:api_def_style_attr="BasicButton=android:buttonStyle;IconButton=sd_iconButtonStyle;LinkButton=sd_linkButtonStyle"
        sdds:api_parent="BasicButton=Sdds.Components.Button;IconButton=Sdds.Components.IconButton;LinkButton=Sdds.Components.LinkButton">
        <attr name="android:insetLeft" />
        <attr name="android:insetTop" />
        <attr name="android:insetRight" />
        <attr name="android:insetBottom" />

        <!-- Дополнительный текст кнопки -->
        <attr name="sd_value" format="string" />
        <!--  Цвет дополнительного текста      -->
        <attr name="sd_valueTextColor" format="reference|color" sdds:api_name="valueColor" sdds:api_res_suffix="value_color"
            sdds:api_state_value="loading=alpha(loadingAlpha)" />
        <!-- Отступ между основным и дополнительным текстом -->
        <attr name="sd_valuePadding" format="dimension" sdds:api_name="valueMargin" />
        <!-- Режим обработки расстояния между основным и дополнительным текстами -->
        <attr name="sd_spacing" format="enum">
            <!-- Отступ между текстами минимальный, но не менее valuePadding -->
            <enum name="packed" value="0" />
            <!-- Отступ между текстами максимальный, насколько позволяют параметры родителя -->
            <enum name="spaceBetween" value="1" />
        </attr>

        <!-- Иконка кнопки -->
        <attr name="sd_icon" format="reference" sdds:api_type="icon" />
        <!-- Окрас иконки кнопки -->
        <attr name="sd_iconTint" format="reference|color" sdds:api_name="iconColor"
            sdds:api_state_value="loading=alpha(loadingAlpha)" />
        <!-- Отступ между иконкой и текстом кнопки -->
        <attr name="sd_iconPadding" format="dimension" sdds:api_name="iconMargin" />
        <!--
            Размер иконки кнопки.
            Если sd_iconSize == 0, то будет использована внутрення ширина иконки (Drawable.getIntrinsicWidth)
         -->
        <attr name="sd_iconSize" format="dimension" />
        <!-- Положение иконки относительно текста -->
        <attr name="sd_iconPosition" format="enum">
            <!-- В начале всего текста -->
            <enum name="textStart" value="0" />
            <!-- В конце всего текста -->
            <enum name="textEnd" value="1" />
        </attr>

        <!-- Размер индикатор загрузки -->
        <attr name="sd_spinnerSize" format="dimension" />
        <!-- Толщина линии индикатора загрузки -->
        <attr name="sd_spinnerStrokeWidth" format="dimension" />
        <!-- Окрас индикатора загрузки -->
        <attr name="sd_spinnerTint" format="reference|color" sdds:api_name="spinnerColor" />

        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="sd_strokeColor" />
        <attr name="sd_strokeWidth" />
        <attr name="sd_disabledAlpha" sdds:api_name="disableAlpha" />
        <attr name="android:checkable" />
        <attr name="android:checked" />
        <attr name="sd_fsAdditionalColor" />
        <attr name="sd_fsMainColor" />
        <attr name="sd_fsMode" />
        <attr name="sd_fsScaleFactor" />
        <attr name="sd_fsStrokeWidth" />
        <attr name="sd_fsStrokeInset" />
        <attr name="sd_fsShapeAppearance" />
        <attr name="sd_fsShapeAdjustment" />
        <attr name="android:minHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="android:minWidth" sdds:api_name="minWidth" sdds:api_type="dimension" />
        <attr name="android:paddingStart" sdds:api_name="paddingStart" sdds:api_type="dimension" />
        <attr name="android:paddingEnd" sdds:api_name="paddingEnd" sdds:api_type="dimension" />
        <attr name="android:textAppearance" sdds:api_name="labelStyle" sdds:api_type="typography" />
        <attr name="android:textColor" sdds:api_name="labelColor" sdds:api_type="color"
            sdds:api_state_value="loading=alpha(loadingAlpha)" />
        <attr name="backgroundTint" sdds:api_name="backgroundColor" sdds:api_res_suffix="bg_color" sdds:api_type="color" />
    </declare-styleable>

    <!-- Компонент - "Группа кнопок". Отображает такие компоненты как Button, IconButton.
         Имеет собственную форму скругления углов, а так же форму скругления дочерних компонентов.
     -->
    <declare-styleable name="ButtonGroup" sdds:api_info="ButtonGroup"
        sdds:api_def_style_attr="sd_buttonGroupStyle"
        sdds:api_parent="Sdds.Components.ButtonGroup" tools:ignore="ResourceName">
        <!-- Оверлэй стиль кнопки -->
        <attr name="sd_buttonStyleOverlay" sdds:api_name="buttonStyle" format="reference" />
        <!-- Форма скруглений наружних углов у крайних элементов группы -->
        <attr name="sd_externalShapeAppearance" format="reference" sdds:api_name="externalShape" />
        <!-- Форма скруглений углов элементов группы -->
        <attr name="sd_internalShapeAppearance" format="reference" sdds:api_name="internalShape" />
        <!-- Отступ между элементами внутри группы -->
        <attr name="sd_buttonSpacing" sdds:api_name="spacing" format="dimension" sdds:api_res_suffix="spacing" />
    </declare-styleable>

</resources>
