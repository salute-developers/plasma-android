<?xml version="1.0" encoding="utf-8"?>
<!-- Namespace sdds: размечает API компонента для генератора стилей.
     См. sdds-core/plugin_theme_builder/VIEW_STYLE_GENERATOR.md -->
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_avatarStyle" format="reference" />
    <attr name="sd_avatarGroupStyle" format="reference" />

    <!-- Drawable-state атрибуты статуса (scoped): порядок здесь не задаёт ordinal статуса —
         ordinal берётся из enum sd_status ниже (none=0/active=1/inactive=2).
         Набор относится и к Indicator: аватар кладёт эти состояния в drawable-state,
         который получает его status-drawable — то есть индикатор. -->
    <declare-styleable name="SdAvatarStatus" sdds:api_info="Avatar,Indicator">
        <attr name="sd_status_active" format="boolean"
            sdds:api_state="AvatarStatus" sdds:api_state_kind="scoped" sdds:api_name="active" />
        <attr name="sd_status_inactive" format="boolean"
            sdds:api_state="AvatarStatus" sdds:api_state_kind="scoped" sdds:api_name="inactive" />
    </declare-styleable>

    <declare-styleable name="Avatar" tools:ignore="ResourceName" sdds:api_info="Avatar"
        sdds:api_def_style_attr="sd_avatarStyle"
        sdds:api_parent="Sdds.Components.Avatar">

        <attr name="sd_status" format="enum">
            <enum name="none" value="0" />
            <enum name="active" value="1" />
            <enum name="inactive" value="2" />
        </attr>

        <attr name="sd_statusSize" format="dimension" />
        <attr name="sd_statusColor" format="color|reference" sdds:api_name="inactiveStatusColor"
            sdds:api_state_value="active=activeStatusColor" />
        <attr name="sd_statusOffsetX" format="dimension|reference" />
        <attr name="sd_statusOffsetY" format="dimension|reference" />
        <attr name="sd_statusStyle" format="reference" />

        <attr name="sd_extraBadgeStyle" sdds:api_name="badgeStyle" format="reference" />
        <attr name="sd_extraBadgeEnabled" format="boolean" />
        <attr name="sd_extraBadgeText" format="string" />
        <attr name="sd_extraBadgeIconStart" format="reference" />
        <attr name="sd_extraBadgeIconEnd" format="reference" />
        <attr name="sd_extraBadgePlacement" format="enum">
            <enum name="topLeft" value="0" />
            <enum name="topRight" value="1" />
            <enum name="bottomRight" value="2" />
            <enum name="bottomLeft" value="3" />
        </attr>

        <attr name="sd_extraCounterStyle" sdds:api_name="counterStyle" format="reference" />
        <attr name="sd_extraCounterEnabled" format="boolean" />
        <attr name="sd_extraCounterText" format="string" />
        <attr name="sd_extraCounterPlacement" format="enum">
            <enum name="topLeft" value="0" />
            <enum name="topRight" value="1" />
            <enum name="bottomRight" value="2" />
            <enum name="bottomLeft" value="3" />
        </attr>

        <attr name="sd_actionEnabled" format="boolean" />
        <attr name="sd_action" sdds:api_type="icon" />
        <attr name="sd_actionScrimColor" format="color" />
        <attr name="sd_actionTint" />
        <attr name="sd_actionSize" />

        <attr name="sd_name" format="string" />
        <attr name="sd_text" format="string" />
        <attr name="android:textAppearance" sdds:api_name="textStyle" sdds:api_type="typography" />
        <attr name="android:textColor" />
        <attr name="sd_textColor"/>
        <attr name="sd_textColorStart" format="color" />
        <attr name="sd_textColorEnd" format="color" />
        <attr name="sd_backgroundAlpha" format="float" />
        <attr name="android:maxHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="android:maxWidth" sdds:api_name="width" sdds:api_type="dimension" />
        <attr name="android:minHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="android:minWidth" sdds:api_name="width" sdds:api_type="dimension" />
        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="sd_background" />
    </declare-styleable>

    <declare-styleable name="AvatarGroup" sdds:api_info="AvatarGroup"
        sdds:api_def_style_attr="sd_avatarGroupStyle"
        sdds:api_parent="Sdds.Components.AvatarGroup" tools:ignore="ResourceName">
        <attr name="sd_itemOffset" format="dimension" />
        <attr name="sd_itemSpacing" format="dimension" />
        <attr name="sd_threshold" format="integer" />

        <attr name="sd_avatarStyleOverlay" sdds:api_name="avatarStyle" format="reference" />
        <attr name="sd_counterBackground" format="reference|color" />
        <attr name="sd_counterEnabled" format="boolean" />
        <attr name="sd_counterTextAppearance" format="reference" />
        <attr name="sd_counterTextColor" format="color" />
        <attr name="sd_counterTextColorStart" format="color" />
        <attr name="sd_counterTextColorEnd" format="color" />

        <attr name="sd_shapeAppearance" />
        <attr name="sd_strokeColor" />
        <attr name="sd_strokeWidth" />
    </declare-styleable>
</resources>
