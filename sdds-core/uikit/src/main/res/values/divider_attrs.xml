<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">
    <attr name="sd_dividerStyle" format="reference" />

    <declare-styleable name="Divider" sdds:api_info="Divider"
        sdds:api_def_style_attr="sd_dividerStyle"
        sdds:api_parent="Sdds.Components.Divider" tools:ignore="ResourceName">
        <attr name="sd_thickness" format="dimension" />
        <attr name="android:orientation" format="dimension" />
        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="android:backgroundTint" />
        <attr name="backgroundTint" sdds:api_name="backgroundColor" sdds:api_res_suffix="bg_color" />
    </declare-styleable>
</resources>