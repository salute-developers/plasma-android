<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_switchStyle" format="reference" />
    <attr name="sd_checkBoxGroupStyle" format="reference" />
    <attr name="sd_radioBoxGroupStyle" format="reference" />
    <attr name="sd_checkBoxStyleOverlay" format="reference" />
    <attr name="sd_radioBoxStyleOverlay" format="reference" />

    <declare-styleable name="SdCheckable">
        <!-- Дополнительный текст  -->
        <attr name="sd_description" format="string" />
        <!-- Стиль дополнительного текста  -->
        <attr name="sd_descriptionTextAppearance" format="reference" />
        <!--  Цвет дополнительного текста      -->
        <attr name="sd_descriptionTextColor" format="reference|color" />
        <!-- Отступ между основным и дополнительным текстом -->
        <attr name="sd_descriptionPadding" format="dimension" />

        <!-- Цвет заливки -->
        <attr name="sd_buttonBoxColor" format="reference|color" />
        <!-- Цвет границы -->
        <attr name="sd_buttonBorderColor" format="reference|color" />
        <!-- Цвет маркера -->
        <attr name="sd_buttonMarkColor" format="reference|color" />

        <attr name="sd_focusBorderEnabled" format="boolean" />

        <attr name="android:textAppearance" />
    </declare-styleable>

    <declare-styleable name="CheckBox" sdds:api_info="CheckBox" sdds:api_framework="labelStyle=android:textAppearance:typography;textPadding=android:drawablePadding:dimension;labelColor=android:textColor:color" tools:ignore="ResourceName">
        <!-- Дополнительный текст  -->
        <attr name="sd_description" />
        <!-- Стиль дополнительного текста  -->
        <attr name="sd_descriptionTextAppearance" sdds:api_name="descriptionStyle" />
        <!--  Цвет дополнительного текста -->
        <attr name="sd_descriptionTextColor" sdds:api_name="descriptionColor" />
        <!-- Отступ между основным и дополнительным текстом -->
        <attr name="sd_descriptionPadding" />

        <attr name="sd_toggleState" format="enum">
            <enum name="off" value="0" />
            <enum name="on" value="1" />
            <enum name="indeterminate" value="2" />
        </attr>

        <!-- Цвет заливки  -->
        <attr name="sd_buttonBoxColor" sdds:api_name="toggleColor" />
        <!-- Цвет границы -->
        <attr name="sd_buttonBorderColor" sdds:api_name="toggleBorderColor" />
        <!-- Цвет маркера -->
        <attr name="sd_buttonMarkColor" sdds:api_name="toggleIconColor" />
        <attr name="sd_buttonMarkColorMode" format="enum">
            <enum name="add" value="0"/>
            <enum name="src_over" value="1"/>
            <enum name="src_in" value="2"/>
            <enum name="src_atop" value="3"/>
            <enum name="multiply" value="4"/>
            <enum name="screen" value="5"/>
        </attr>

        <attr name="sd_focusBorderEnabled" />

    </declare-styleable>

    <declare-styleable name="RadioBox" sdds:api_info="RadioBox" tools:ignore="ResourceName">
        <!-- Дополнительный текст  -->
        <attr name="sd_description" />
        <!-- Стиль дополнительного текста  -->
        <attr name="sd_descriptionTextAppearance" />
        <!--  Цвет дополнительного текста -->
        <attr name="sd_descriptionTextColor" />
        <!-- Отступ между основным и дополнительным текстом -->
        <attr name="sd_descriptionPadding" />

        <!-- Цвет заливки -->
        <attr name="sd_buttonBoxColor" />
        <!-- Цвет границы -->
        <attr name="sd_buttonBorderColor" />
        <!-- Цвет маркера -->
        <attr name="sd_buttonMarkColor" />
        <attr name="sd_buttonMarkColorMode" />

        <attr name="sd_focusBorderEnabled" />
    </declare-styleable>

    <declare-styleable name="Switch" sdds:api_info="Switch" sdds:api_framework="textPadding=android:drawablePadding:dimension;paddingStart=android:paddingStart:dimension;paddingTop=android:paddingTop:dimension;paddingEnd=android:paddingEnd:dimension;paddingBottom=android:paddingBottom:dimension;labelColor=android:textColor:color" tools:ignore="ResourceName">
        <!-- Цвет неподвижной части переключателя -->
        <attr name="sd_buttonTrackColor" sdds:api_name="toggleTrackColor" format="reference|color" />
        <!-- Цвет бордера неподвижной части переключателя -->
        <attr name="sd_buttonTrackBorderColor" sdds:api_name="toggleTrackBorderColor" format="reference|color" />
        <!-- Цвет подвижной части переключателя -->
        <attr name="sd_buttonThumbColor" sdds:api_name="toggleThumbColor" format="reference|color" />
        <!-- Стиль основного текста  -->
        <attr name="sd_textAppearance" />
        <!-- Стиль дополнительного текста  -->
        <attr name="sd_descriptionTextAppearance" />
        <attr name="sd_buttonThumbColorMode"/>
        <attr name="sd_shapeAppearance"/>
        <attr name="sd_background" sdds:api_name="backgroundColor"/>
    </declare-styleable>

    <declare-styleable name="SdCheckBoxDrawable" sdds:api_info="CheckBox">
        <attr name="sd_toggleWidth" format="dimension|float|reference" />
        <attr name="sd_toggleHeight" format="dimension|float|reference" />
        <attr name="sd_boxCornerRadius" format="dimension|float" />
        <attr name="sd_buttonPadding" sdds:api_name="togglePadding" format="dimension|float" />
        <attr name="sd_focusBorderEnabled" />
        <attr name="sd_checkedIcon" format="reference"/>
        <attr name="sd_indeterminateIcon" format="reference"/>
        <attr name="sd_shapeAppearance"/>
        <attr name="sd_toggleBorderWidth" format="dimension|float|reference"/>
        <attr name="sd_toggleIconWidth" format="dimension|float|reference"/>
        <attr name="sd_toggleIconHeight" format="dimension|float|reference"/>
        <attr name="sd_toggleBorderOffset" format="dimension|float|reference"/>
        <attr name="sd_buttonMarkColorMode" />
    </declare-styleable>

    <declare-styleable name="SdRadioBoxDrawable" sdds:api_info="RadioBox">
        <attr name="sd_toggleWidth" />
        <attr name="sd_toggleHeight" />
        <attr name="sd_buttonPadding" sdds:api_name="togglePadding" />
        <attr name="sd_focusBorderEnabled" />
        <attr name="sd_checkedIcon" />
        <attr name="sd_shapeAppearance"/>
        <attr name="sd_toggleBorderWidth" />
        <attr name="sd_toggleIconWidth" />
        <attr name="sd_toggleIconHeight" />
        <attr name="sd_toggleBorderOffset" />
        <attr name="sd_buttonMarkColorMode" />
    </declare-styleable>

    <declare-styleable name="SdSwitchDrawable" sdds:api_info="Switch">
        <attr name="sd_switchWidth" sdds:api_name="toggleTrackWidth" format="dimension|float" />
        <attr name="sd_switchBorderWidth" format="dimension|float" />
        <attr name="sd_switchHeight" sdds:api_name="toggleTrackHeight" format="dimension|float" />
        <attr name="sd_thumbWidth" sdds:api_name="toggleThumbWidth" format="dimension|float" />
        <attr name="sd_thumbHeight" sdds:api_name="toggleThumbHeight" format="dimension|float" />
        <attr name="sd_thumbPadding" format="dimension|float" />
        <attr name="sd_shapeAppearance"/>
        <attr name="sd_background" sdds:api_name="backgroundColor"/>
        <attr name="sd_thumbShapeAppearance" format="reference" />
        <attr name="sd_trackShapeAppearance" format="reference" />
        <attr name="sd_buttonThumbColorMode" format="enum">
            <enum name="add" value="0"/>
            <enum name="src_over" value="1"/>
            <enum name="src_in" value="2"/>
            <enum name="src_atop" value="3"/>
            <enum name="multiply" value="4"/>
            <enum name="screen" value="5"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="CheckBoxGroup" sdds:api_info="CheckBoxGroup" tools:ignore="ResourceName">
        <attr name="sd_hasMain" format="boolean" />
        <attr name="sd_checkBoxStyleOverlay" sdds:api_name="checkBoxStyle" />
        <attr name="sd_itemOffset" />
        <attr name="sd_itemSpacing" />
    </declare-styleable>

    <declare-styleable name="RadioBoxGroup" sdds:api_info="RadioBoxGroup" tools:ignore="ResourceName">
        <attr name="sd_radioBoxStyleOverlay" sdds:api_name="radioBoxStyle" />
        <attr name="sd_itemSpacing" />
    </declare-styleable>
</resources>