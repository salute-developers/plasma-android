<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_carouselStyle" format="reference" />

    <item name="sd_carouselNextButtonId" type="id"/>
    <item name="sd_carouselPrevButtonId" type="id"/>

    <declare-styleable name="Carousel" sdds:api_info="Carousel"
        sdds:api_def_style_attr="sd_carouselStyle"
        sdds:api_parent="Sdds.Components.Carousel" tools:ignore="ResourceName">
        <attr name="sd_paginationDotsStyleOverlay" sdds:api_name="indicatorStyle" format="reference" />
        <attr name="sd_nextButtonStyleOverlay" sdds:api_name="nextButtonStyle" format="reference" />
        <attr name="sd_prevButtonStyleOverlay" sdds:api_name="prevButtonStyle" format="reference" />

        <attr name="sd_indicatorVisibleItemCount" format="integer" />
        <attr name="sd_indicatorEnabled" format="boolean" />
        <attr name="sd_indicatorPadding" format="dimension" />

        <attr name="sd_nextButtonPadding" format="dimension" sdds:api_res_suffix="next_padding" />
        <attr name="sd_nextButtonIcon" format="reference" />
        <attr name="sd_prevButtonPadding" format="dimension" sdds:api_res_suffix="prev_padding" />
        <attr name="sd_prevButtonIcon" format="dimension" sdds:api_type="icon" />
        <attr name="sd_controlsEnabled"/>
        <attr name="sd_controlsPlacement" sdds:api_name="buttonsPlacement" format="enum">
            <enum name="inner" value="0"/>
            <enum name="outer" value="1"/>
        </attr>

        <attr name="sd_gap"/>
        <attr name="sd_offscreenOffset" format="dimension" />
        <attr name="sd_contentAlignment" format="enum">
            <enum name="start" value="0"/>
            <enum name="center" value="1"/>
            <enum name="end" value="2"/>
        </attr>
    </declare-styleable>
</resources>