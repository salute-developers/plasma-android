<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_chipStyle" format="reference" />
    <attr name="sd_chipGroupStyle" format="reference" />
    <attr name="sd_chipStyleOverlay" format="reference" />
    <attr name="sd_chipGroupStyleOverlay" format="reference" />

    <declare-styleable name="Chip" sdds:api_info="Chip"
        sdds:api_def_style_attr="sd_chipStyle"
        sdds:api_parent="Sdds.Components.Chip" tools:ignore="ResourceName">
        <attr name="android:drawableStart" />
        <attr name="android:drawableEnd" />
        <attr name="sd_drawableStartTint" sdds:api_name="contentStartColor" />
        <attr name="sd_drawableEndTint" sdds:api_name="contentEndColor" />
        <attr name="sd_drawableSize" />
        <attr name="sd_contentStartSize" sdds:api_name="contentStartSize" />
        <attr name="sd_contentEndSize" sdds:api_name="contentEndSize" />

        <attr name="android:text" />
        <attr name="android:textAppearance" sdds:api_name="labelStyle" sdds:api_type="typography" />
        <attr name="android:textColor" sdds:api_name="labelColor" sdds:api_type="color" />
        <attr name="sd_textPaddingStart" sdds:api_name="contentStartPadding" />
        <attr name="sd_textPaddingEnd" sdds:api_name="contentEndPadding" />

        <attr name="android:backgroundTint" sdds:api_name="backgroundColor" sdds:api_type="color" sdds:api_res_suffix="bg_color" />
        <attr name="backgroundTint" />
        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="sd_viewState" />
        <attr name="sd_strokeColor" />
        <attr name="sd_strokeWidth" />
        <attr name="android:checkable" />
        <attr name="android:checked" />
        <attr name="sd_fsAdditionalColor" />
        <attr name="sd_fsMainColor" />
        <attr name="sd_fsMode" />
        <attr name="sd_fsScaleFactor" />
        <attr name="sd_fsStrokeWidth" />
        <attr name="sd_fsStrokeInset" />
        <attr name="sd_fsShapeAppearance" />
        <attr name="sd_fsShapeAdjustment" />
        <attr name="android:paddingStart" sdds:api_name="paddingStart" sdds:api_type="dimension" />
        <attr name="android:paddingTop" sdds:api_name="paddingTop" sdds:api_type="dimension" />
        <attr name="android:paddingEnd" sdds:api_name="paddingEnd" sdds:api_type="dimension" />
        <attr name="android:paddingBottom" sdds:api_name="paddingBottom" sdds:api_type="dimension" />
        <attr name="android:minHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="sd_disabledAlpha" sdds:api_name="disableAlpha" />
    </declare-styleable>

    <declare-styleable name="ChipGroup" sdds:api_info="ChipGroup"
        sdds:api_def_style_attr="sd_chipGroupStyle"
        sdds:api_parent="Sdds.Components.ChipGroup" tools:ignore="ResourceName">
        <attr name="sd_chipStyleOverlay" sdds:api_name="chipStyle" />
        <attr name="sd_gap" />
        <attr name="sd_lineSpacing" />
        <attr name="android:gravity" />

        <attr name="sd_shapeAppearance" />
        <attr name="sd_shapeAppearanceAdjustment" />
        <attr name="sd_strokeWidth" />
        <attr name="sd_strokeColor" />
        <attr name="sd_viewState" />
        <attr name="sd_disabledAlpha" sdds:api_name="disableAlpha" />
    </declare-styleable>

    <declare-styleable name="ChipGroup_Layout" tools:ignore="ResourceName">
        <attr name="android:layout_gravity" />
    </declare-styleable>
</resources>