<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_chipStyle" format="reference" />
    <attr name="sd_chipGroupStyle" format="reference" />
    <attr name="sd_chipStyleOverlay" format="reference" />
    <attr name="sd_chipGroupStyleOverlay" format="reference" />

    <declare-styleable name="Chip" sdds:api_info="Chip" sdds:api_framework="paddingStart=android:paddingStart:dimension;paddingTop=android:paddingTop:dimension;paddingEnd=android:paddingEnd:dimension;paddingBottom=android:paddingBottom:dimension;contentMinWidth=android:minWidth:dimension;contentMinHeight=android:minHeight:dimension;backgroundColor=android:backgroundTint:color;labelStyle=android:textAppearance:typography;height=android:minHeight:dimension;labelColor=android:textColor:color;width=android:minWidth:dimension;startPadding=android:paddingStart:dimension;endPadding=android:paddingEnd:dimension" tools:ignore="ResourceName">
        <attr name="android:drawableStart" />
        <attr name="android:drawableEnd" />
        <attr name="sd_drawableStartTint" sdds:api_name="contentStartColor" />
        <attr name="sd_drawableEndTint" sdds:api_name="contentEndColor" />
        <attr name="sd_drawableSize" />
        <attr name="sd_contentStartSize" sdds:api_name="startContentSize" />
        <attr name="sd_contentEndSize" sdds:api_name="endContentSize" />

        <attr name="android:text" />
        <attr name="android:textAppearance" />
        <attr name="android:textColor" />
        <attr name="sd_textPaddingStart" sdds:api_name="startContentMargin" />
        <attr name="sd_textPaddingEnd" sdds:api_name="endContentMargin" />

        <attr name="android:backgroundTint" />
        <attr name="backgroundTint" />
        <attr name="sd_shapeAppearance" />
        <attr name="sd_viewState" />
        <attr name="sd_strokeColor" />
        <attr name="sd_strokeWidth" />
        <attr name="android:checkable" />
        <attr name="android:checked" />
        <attr name="sd_fsAdditionalColor" />
        <attr name="sd_fsMainColor" />
        <attr name="sd_fsMode" />
        <attr name="sd_fsScaleFactor" />
        <attr name="sd_fsStrokeWidth" />
        <attr name="sd_fsStrokeInset" />
        <attr name="sd_fsShapeAppearance" />
        <attr name="sd_fsShapeAdjustment" />
    </declare-styleable>

    <declare-styleable name="ChipGroup" sdds:api_info="ChipGroup" tools:ignore="ResourceName">
        <attr name="sd_chipStyleOverlay" sdds:api_name="chipStyle" />
        <attr name="sd_gap" />
        <attr name="sd_lineSpacing" />
        <attr name="android:gravity" />

        <attr name="sd_shapeAppearance" />
        <attr name="sd_shapeAppearanceAdjustment" />
        <attr name="sd_strokeWidth" />
        <attr name="sd_strokeColor" />
        <attr name="sd_viewState" />
    </declare-styleable>

    <declare-styleable name="ChipGroup_Layout" tools:ignore="ResourceName">
        <attr name="android:layout_gravity" />
    </declare-styleable>
</resources>