<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_tooltipStyle" format="reference" />

    <declare-styleable name="Tooltip" sdds:api_info="Tooltip"
        sdds:api_def_style_attr="sd_tooltipStyle"
        sdds:api_parent="Sdds.Components.Tooltip" tools:ignore="ResourceName">
        <attr name="sd_offset" />
        <attr name="sd_shadowAppearance" sdds:api_name="shadow" />
        <attr name="sd_background" sdds:api_name="backgroundColor" sdds:api_res_suffix="bg_color" sdds:api_type="color" />

        <attr name="sd_contentStart" format="reference" />
        <attr name="sd_contentStartTint" sdds:api_name="contentStartColor" format="reference|color" sdds:api_res_suffix="content_start_color" />
        <attr name="sd_contentStartSize"  />
        <attr name="sd_contentStartPadding"  />

        <attr name="android:text" />
        <attr name="android:textAppearance" sdds:api_name="textStyle" sdds:api_type="typography" />
        <attr name="android:textColor" />
        <attr name="sd_textColor" />
        <attr name="android:maxLines" />

        <attr name="android:paddingStart" sdds:api_name="paddingStart" sdds:api_type="dimension" />
        <attr name="android:paddingEnd" sdds:api_name="paddingEnd" sdds:api_type="dimension" />
        <attr name="android:paddingTop" sdds:api_name="paddingTop" sdds:api_type="dimension" />
        <attr name="android:paddingBottom" sdds:api_name="paddingBottom" sdds:api_type="dimension" />
        <attr name="android:minWidth"/>
        <attr name="android:minHeight"/>

        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="sd_shapeAppearanceAdjustment" />
        <attr name="sd_strokeWidth" />
        <attr name="sd_strokeColor" />
        <attr name="sd_clipToOutline" />
        <attr name="sd_shapeTailWidth" sdds:api_name="tailWidth" sdds:api_res_suffix="tail_width" />
        <attr name="sd_shapeTailHeight" sdds:api_name="tailHeight" sdds:api_res_suffix="tail_height" />
        <attr name="sd_shapeTailOffset" sdds:api_name="tailPadding" sdds:api_res_suffix="tail_offset" />
        <attr name="sd_shapeTailEnabled" />
        <attr name="sd_shapeTailPlacement" />
        <attr name="sd_shapeTailAlignment" />
    </declare-styleable>
</resources>