<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_dropdownMenuStyle" format="reference" />
    <attr name="sd_dropdownEmptyStateStyle" format="reference" />

    <declare-styleable name="DropdownMenu" sdds:api_info="DropdownMenu" sdds:api_framework="width=android:minWidth:dimension;paddingStart=android:paddingStart:dimension;paddingTop=android:paddingTop:dimension;paddingEnd=android:paddingEnd:dimension;paddingBottom=android:paddingBottom:dimension" tools:ignore="ResourceName">
        <attr name="sd_itemDividerEnabled" format="boolean" />
        <attr name="sd_listViewStyleOverlay" sdds:api_name="listStyle" format="reference" />
        <attr name="sd_dividerStyleOverlay" sdds:api_name="dividerStyle" format="reference" />
        <attr name="sd_scrollBarStyleOverlay" sdds:api_name="scrollBarStyle" format="reference"/>
        <attr name="sd_emptyStateStyleOverlay" sdds:api_name="emptyStateStyle" format="reference"/>
        <attr name="android:padding"/>
        <attr name="android:paddingTop"/>
        <attr name="android:paddingStart"/>
        <attr name="android:paddingEnd"/>
        <attr name="android:paddingBottom"/>
        <attr name="sd_scrollBarPaddingTop"/>
        <attr name="sd_scrollBarPaddingBottom"/>
    </declare-styleable>

    <declare-styleable name="DropdownEmptyStateView" sdds:api_info="DropdownEmptyStateView" sdds:api_framework="paddingStart=android:paddingStart:dimension;paddingEnd=android:paddingEnd:dimension;paddingTop=android:paddingTop:dimension;paddingBottom=android:paddingBottom:dimension" tools:ignore="ResourceName">
        <attr name="sd_icon" />
        <attr name="sd_iconTint" sdds:api_name="iconColor" />

        <attr name="sd_description" />
        <attr name="sd_descriptionPadding" />
        <attr name="sd_descriptionTextColor" sdds:api_name="descriptionColor" />
        <attr name="sd_descriptionTextAppearance" sdds:api_name="descriptionStyle" />

        <attr name="sd_actionButtonText" format="string" />
        <attr name="sd_actionButtonStyleOverlay" sdds:api_name="buttonStyle" format="reference" />

    </declare-styleable>
</resources>