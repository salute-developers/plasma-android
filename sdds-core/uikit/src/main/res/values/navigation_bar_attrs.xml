<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_navigationBarStyle" format="reference" />

    <declare-styleable name="NavigationBar" sdds:api_info="NavigationBar"
        sdds:api_def_style_attr="sd_navigationBarStyle"
        sdds:api_parent="Sdds.Components.NavigationBar" tools:ignore="ResourceName">
        <!-- Оверлэй стиль компонента IconButton -->
        <attr name="sd_iconButtonStyleOverlay" sdds:api_name="actionButtonStyle" />

        <!-- Стиль тени -->
        <attr name="sd_shadowAppearance" sdds:api_name="shadow" />
        <!-- Форма компонента -->
        <attr name="sd_shapeAppearance" sdds:api_name="bottomShape" />
        <!-- Корректировка формы компонента -->
        <attr name="sd_shapeAppearanceAdjustment" />
        <!-- Отступ в начале блока, содержащего actions -->
        <attr name="sd_contentPaddingStart" sdds:api_name="paddingStart" />
        <!-- Отступ в конце блока, содержащего actions -->
        <attr name="sd_contentPaddingEnd" sdds:api_name="paddingEnd" />
        <!-- Верхний отступ блока, содержащего actions -->
        <attr name="sd_contentPaddingTop" sdds:api_name="paddingTop" />
        <!-- Нижний отступ блока, содержащего actions -->
        <attr name="sd_contentPaddingBottom" sdds:api_name="paddingBottom" />
        <!-- Отступ между Title и Description -->
        <attr name="sd_descriptionMargin" format="dimension|reference" sdds:api_name="descriptionPadding" sdds:api_type="dimension" />
        <!-- Минимальная высота блока, содержащего actions. Не включает отступы sd_contentPaddingTop и sd_contentPaddingBottom -->
        <attr name="sd_minContentHeight" format="dimension|reference" sdds:api_name="minContentHeight" sdds:api_type="dimension" />
        <!-- Ссылка на ресурс иконки "назад" -->
        <attr name="sd_backIcon" format="reference" />
        <!-- Отступ от иконки "назад" и ActionStart  -->
        <attr name="sd_backIconMargin" format="dimension" />
        <!-- Верхний отступ от текстового блока если он находится ниже actions  -->
        <attr name="sd_textBlockTopMargin" format="dimension" />
        <!-- Отступ от actions и между контентом в блоке с actions  -->
        <attr name="sd_horizontalSpacing" format="dimension" />
        <!-- Цвет action в начале  -->
        <attr name="sd_actionStartColor" format="reference|color" />
        <!-- Цвет action в конце  -->
        <attr name="sd_actionEndColor" format="reference|color" />

        <!-- Стиль текста Title  -->
        <attr name="sd_titleAppearance" sdds:api_name="titleStyle" />
        <!-- Цвет текста Title  -->
        <attr name="sd_titleColor" />

        <!-- Окрас иконки "назад"  -->
        <attr name="sd_backIconTint" sdds:api_name="backIconColor" format="reference|color"/>

        <!-- Стиль текста Description  -->
        <attr name="sd_descriptionAppearance" sdds:api_name="descriptionStyle" />
        <!-- Цвет текста Description  -->
        <attr name="sd_descriptionColor" />
        <!-- Цвет фона  -->
        <attr name="sd_background" sdds:api_name="backgroundColor" sdds:api_type="color" />

        <!-- Расположение компонента с ролью Content -->
        <attr name="sd_navbarContentPlacement"
            format="enum">
            <!-- Размещает Content в одном блоке с ActionStart и  ActionEnd -->
            <enum name="inline" value="0" />
            <!-- Размещает Content снизу NavigationBar, под компонентами с ролью Title и Description -->
            <enum name="bottom" value="1" />
        </attr>

        <!-- Расположение компонентов с ролью Title и Description -->
        <attr name="sd_navbarTextPlacement" format="enum">
            <!-- Размещает компоненты с ролью Title и Description в одном блоке с ActionStart и ActionEnd по горизонтали  -->
            <enum name="inline" value="0" />
            <!-- Размещает компоненты с ролью Title и Description под основным блоком с компонентами ActionStart и ActionEnd -->
            <enum name="bottom" value="1" />
        </attr>

        <!-- Выравнивание компонентов с ролью Title и Description -->
        <attr name="sd_navbarTextAlignment" format="enum">
            <!-- Выравнивает компоненты с ролью Title и Description по краю в начале  -->
            <enum name="start" value="0" />
            <!-- Выравнивает компоненты с ролью Title и Description по центру  -->
            <enum name="center" value="1" />
            <!-- Выравнивает компоненты с ролью Title и Description по краю в конце -->
            <enum name="end" value="2" />
        </attr>

        <!-- Выравнивание контента, находящегося между ActionStart и ActionEnd по горизонтали -->
        <attr name="sd_contentAlignmentBetweenActions" format="enum">
            <!-- Выравнивает контент по краю в начале  -->
            <enum name="start" value="0" />
            <!-- Выравнивает контент по центру  -->
            <enum name="center" value="1" />
            <!-- Выравнивает контент по краю в конце -->
            <enum name="end" value="2" />
        </attr>

        <!-- Центрирование контента, находящегося в одном блоке с ActionStart и ActionEnd по горизонтали -->
        <attr name="sd_centerAlignmentStrategy"
            format="enum">
            <!-- Контент будет центрирован относительно ширины NavigationBar -->
            <enum name="absolute" value="0" />
            <!-- Контент будет центрирован относительно ширины блока, находящегося между ActionStart и ActionEnd -->
            <enum name="relative" value="1" />
        </attr>

        <attr name="sd_state_collapsed" sdds:api_state="NavigationBarCollapse" sdds:api_state_kind="shared" sdds:api_name="text-inlined" />
    </declare-styleable>

    <declare-styleable name="NavigationBar_Layout" tools:ignore="ResourceName">
        <!-- Роли компонентов, размещаемых внутри NavigationBar -->
        <attr name="layout_navigationBarContent" format="enum">
            <!-- Заголовок -->
            <enum name="title" value="0" />
            <!-- Описание -->
            <enum name="description" value="1" />
            <!-- Компонент, расположенный вначале, предусматривающий взаимодействие (например нажатие) -->
            <enum name="action_start" value="2" />
            <!-- Компонент, расположенный вконце, предусматривающий взаимодействие (например нажатие) -->
            <enum name="action_end" value="3"/>
            <!-- Контент -->
            <enum name="content" value="4" />
        </attr>
    </declare-styleable>
</resources>