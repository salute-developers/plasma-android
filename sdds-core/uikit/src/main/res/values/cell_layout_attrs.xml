<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_cellStyle" format="reference" />

    <declare-styleable name="CellLayout" sdds:api_info="Cell"
        sdds:api_def_style_attr="sd_cellStyle"
        sdds:api_parent="Sdds.Components.Cell" tools:ignore="ResourceName">
        <attr name="android:gravity" />
        <attr name="sd_contentStartPadding" sdds:api_name="contentPaddingStart" format="dimension" />
        <attr name="sd_contentEndPadding" sdds:api_name="contentPaddingEnd" format="dimension" />

        <attr name="sd_labelAppearance" sdds:api_name="labelStyle" />
        <attr name="sd_labelColor" />

        <attr name="sd_titleAppearance" format="reference" sdds:api_name="titleStyle" />
        <attr name="sd_titleColor" format="color" />

        <attr name="sd_subtitleAppearance" format="reference" sdds:api_name="subtitleStyle" />
        <attr name="sd_subtitleColor" format="color" />

        <attr name="sd_disclosureEnabled" format="boolean" />
        <attr name="sd_disclosurePadding" format="dimension" />
        <attr name="sd_disclosureText" format="string" />
        <attr name="sd_disclosureTextAppearance" format="reference" sdds:api_name="disclosureTextStyle" sdds:api_res_suffix="disclosure_appearance" />
        <attr name="sd_disclosureColor" sdds:api_name="disclosureIconColor" format="color" />
        <attr name="sd_disclosureTextColor" format="color" />
        <attr name="sd_disclosureIcon" format="reference" />
        <attr name="sd_forceDuplicateParentState" format="boolean" />

        <attr name="sd_background" sdds:api_name="backgroundColor" sdds:api_type="color" />
        <attr name="sd_backgroundAnimationDuration"/>
        <attr name="sd_backgroundAnimationInterpolator"/>
        <attr name="sd_textAnimationDuration"/>
        <attr name="sd_textAnimationInterpolator"/>
        <attr name="sd_imageAnimationDuration"/>
        <attr name="sd_imageAnimationInterpolator"/>
        <attr name="sd_shapeAppearance"/>
        <attr name="sd_shapeAppearanceAdjustment"/>
        <attr name="sd_strokeWidth"/>
        <attr name="sd_strokeColor"/>
        <attr name="sd_clipToOutline"/>
        <attr name="sd_fsAdditionalColor" />
        <attr name="sd_fsMainColor" />
        <attr name="sd_fsMode" />
        <attr name="sd_fsScaleFactor" />
        <attr name="sd_fsStrokeWidth" />
        <attr name="sd_fsStrokeInset" />
        <attr name="sd_fsShapeAppearance" />
        <attr name="sd_fsShapeAdjustment" />
        <attr name="android:buttonStyle" sdds:api_name="iconButtonStyle" sdds:api_type="component_style" sdds:api_placement="overlay" />
        <attr name="android:radioButtonStyle" sdds:api_name="radioBoxStyle" sdds:api_type="component_style" sdds:api_placement="overlay" />
        <attr name="android:checkboxStyle" sdds:api_name="checkBoxStyle" sdds:api_type="component_style" sdds:api_placement="overlay" />
        <attr name="android:paddingStart" sdds:api_name="paddingStart" sdds:api_type="dimension" />
        <attr name="android:paddingEnd" sdds:api_name="paddingEnd" sdds:api_type="dimension" />
        <attr name="android:paddingTop" sdds:api_name="paddingTop" sdds:api_type="dimension" />
        <attr name="android:paddingBottom" sdds:api_name="paddingBottom" sdds:api_type="dimension" />
        <attr name="android:minHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="sd_avatarStyle" sdds:api_placement="overlay" />
        <attr name="sd_switchStyle" sdds:api_placement="overlay" />
        <attr name="android:theme" sdds:api_placement="theme" />
    </declare-styleable>

    <declare-styleable name="CellLayout_Layout" tools:ignore="ResourceName">
        <attr name="android:layout_gravity" />
        <attr name="sd_layout_forceDuplicateParentState" format="boolean" />
        <attr name="layout_cellContent" format="enum">
            <enum name="start" value="0" />
            <enum name="center" value="1" />
            <enum name="end" value="2" />
            <enum name="label" value="3"/>
            <enum name="title" value="4"/>
            <enum name="subtitle" value="5"/>
            <enum name="disclosure" value="6"/>
        </attr>
    </declare-styleable>
</resources>