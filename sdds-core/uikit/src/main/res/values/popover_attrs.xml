<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">

    <attr name="sd_popoverStyle" format="reference" />

    <declare-styleable name="Popover" sdds:api_info="Popover"
        sdds:api_def_style_attr="sd_popoverStyle"
        sdds:api_parent="Sdds.Components.Popover" tools:ignore="ResourceName">
        <attr name="sd_offset" format="dimension" />
        <attr name="sd_clipWidth" format="boolean" />
        <attr name="sd_clipHeight" format="boolean" />
        <attr name="sd_shadowAppearance" sdds:api_name="shadow" />
        <attr name="sd_background" sdds:api_name="backgroundColor" sdds:api_res_suffix="bg_color" sdds:api_type="color" />

        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
        <attr name="sd_shapeAppearanceAdjustment" />
        <attr name="sd_strokeWidth" />
        <attr name="sd_strokeColor" />
        <attr name="sd_clipToOutline" />
        <attr name="sd_shapeTailWidth" sdds:api_name="tailWidth" sdds:api_res_suffix="tail_width" />
        <attr name="sd_shapeTailHeight" sdds:api_name="tailHeight" sdds:api_res_suffix="tail_height" />
        <attr name="sd_shapeTailOffset" sdds:api_name="tailPadding" sdds:api_res_suffix="tail_offset" />
        <attr name="sd_shapeTailEnabled" />
        <attr name="sd_shapeTailPlacement" />
        <attr name="sd_shapeTailAlignment" />
        <attr name="android:minWidth" sdds:api_name="width" sdds:api_type="dimension" />
    </declare-styleable>
</resources>