<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">
    <attr name="sd_editableStyle" format="reference" />

    <declare-styleable name="Editable" sdds:api_info="Editable"
        sdds:api_def_style_attr="sd_editableStyle"
        sdds:api_parent="Sdds.Components.Editable" tools:ignore="ResourceName" >
        <!--  Иконка (drawable ресурс) -->
        <attr name="sd_icon" />
        <!--  Цвет иконки (drawable) -->
        <attr name="sd_iconTint" sdds:api_name="iconColor" />
        <!--  Размер иконки (drawable) -->
        <attr name="sd_iconSize" />
        <!--  Отступ иконки (drawable) от текстового поля -->
        <attr name="sd_iconMargin" />
        <!--  Цвет текста -->
        <attr name="sd_valueColor" sdds:api_name="textColor" />
        <!--  Стиль текста -->
        <attr name="sd_valueAppearance" sdds:api_name="textStyle" />
        <!--  Цвет курсора -->
        <attr name="sd_cursorColor" />
        <!--  Расположение иконки (drawable) -->
        <attr name="sd_editableIconPlacement" format="enum" >
            <!--  Drawable не учавствует в размерах Editable, рисуется за границами -->
            <enum name="absolute" value="0" />
            <!--  Drawable учавствует в размерах Editable, рисуется в пределах границ -->
            <enum name="relative" value="1" />
        </attr>
        <attr name="android:textAppearance" />
        <attr name="android:textColor" />
        <attr name="sd_disabledAlpha" sdds:api_name="disableAlpha" />
    </declare-styleable>
</resources>