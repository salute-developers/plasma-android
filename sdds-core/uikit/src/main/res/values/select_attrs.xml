<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
           xmlns:sdds="http://schemas.sdds.ru/android/sdds">
    <attr name="sd_selectStyle" format="reference" />
    <attr name="sd_selectItemStyle" format="reference" />
    <attr name="sd_selectItemStyleOverlay" format="reference" />

    <declare-styleable name="Select" sdds:api_info="Select"
        sdds:api_def_style_attr="sd_selectStyle"
        sdds:api_parent="Sdds.Components.Select" tools:ignore="ResourceName">
        <!-- Оверлэй стиль компонента Button -->
        <attr name="sd_buttonStyleOverlay" sdds:api_name="buttonStyle" />
        <!-- Оверлэй стиль компонента TextField -->
        <attr name="sd_textFieldStyleOverlay" sdds:api_name="textFieldStyle" />
        <!-- Оверлэй стиль компонента DropdownMenu -->
        <attr name="sd_dropdownMenuStyleOverlay" sdds:api_name="dropdownStyle" />
        <!-- Оверлэй стиль компонента SelectItem -->
        <attr name="sd_selectItemStyleOverlay" sdds:api_name="selectItemStyle" />
    </declare-styleable>

    <declare-styleable name="SelectItem" sdds:api_info="SelectItem"
        sdds:api_core_name="SelectIem"
        sdds:api_def_style_attr="sd_selectItemStyle"
        sdds:api_parent="Sdds.Components.SelectItem" tools:ignore="ResourceName">
        <!-- Оверлэй стиль компонента CellLayout -->
        <attr name="sd_cellStyleOverlay" sdds:api_name="cellStyle" format="reference" />
        <!-- Оверлэй стиль компонента CheckBox -->
        <attr name="sd_checkBoxStyleOverlay" sdds:api_name="checkboxStyle" />
        <!-- Цвет фона -->
        <attr name="sd_background" sdds:api_name="backgroundColor" sdds:api_type="color" />
        <attr name="android:checked" />
        <attr name="android:checkable" />
        <!-- Окрас иконки отвечающей за checked состояние -->
        <attr name="sd_iconTint" sdds:api_name="iconColor" />
        <!-- Иконка отвечающая за checked состояние -->
        <attr name="sd_icon" />
        <!-- Отступ основного контента от элемента отвечающего за checked состояние -->
        <attr name="sd_controlMargin" format="dimension" />
        <!-- Размер области для элемента отвечающего за checked состояние -->
        <attr name="sd_controlSize" format="dimension" />
        <!-- Тип SelectItem в Select -->
        <attr name="sd_itemType" format="enum">
            <!-- В checked состоянии будет показана иконка -->
            <enum name="single" value="0" />
            <!-- В checked состоянии будет показан CheckBox -->
            <enum name="multiple" value="1" />
        </attr>
        <attr name="android:minHeight" sdds:api_name="height" sdds:api_type="dimension" />
        <attr name="android:paddingStart" sdds:api_name="paddingStart" sdds:api_type="dimension" />
        <attr name="android:paddingEnd" sdds:api_name="paddingEnd" sdds:api_type="dimension" />
        <attr name="android:paddingTop" sdds:api_name="paddingTop" sdds:api_type="dimension" />
        <attr name="android:paddingBottom" sdds:api_name="paddingBottom" sdds:api_type="dimension" />
        <attr name="sd_disabledAlpha" sdds:api_name="disableAlpha" />
        <attr name="sd_shapeAppearance" sdds:api_name="shape" />
    </declare-styleable>

    <declare-styleable name="SelectItem_Layout" tools:ignore="ResourceName">
        <attr name="android:layout_gravity" />
        <attr name="sd_layout_forceDuplicateParentState" />
        <!-- Роли компонентов, размещаемых внутри SelectItem -->
        <attr name="layout_itemContent" format="enum">
            <enum name="start" value="0" />
            <enum name="center" value="1" />
            <enum name="end" value="2" />
            <enum name="label" value="3" />
            <enum name="title" value="4" />
            <enum name="subtitle" value="5" />
            <enum name="disclosure" value="6" />
        </attr>
    </declare-styleable>

</resources>