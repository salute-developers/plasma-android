{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdds.dev/preview/v1/preview-component-description-result.schema.json",
  "$defs": {
    "property": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "name", "defaultValue"],
          "properties": {
            "type": { "const": "string" },
            "name": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name", "defaultValue"],
          "properties": {
            "type": { "const": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name", "defaultValue"],
          "properties": {
            "type": { "const": "int" },
            "name": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name", "defaultValue"],
          "properties": {
            "type": { "const": "float" },
            "name": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name", "defaultValue", "variants"],
          "properties": {
            "type": { "const": "singleChoice" },
            "name": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "string" },
            "variants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" },
              "contains": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "description": {
      "type": "object",
      "required": ["protocolVersion", "componentId", "storyId", "properties"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "storyId": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "requestId", "description"],
      "properties": {
        "type": { "const": "success" },
        "requestId": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/description" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "requestId", "code", "message"],
      "properties": {
        "type": { "const": "failure" },
        "requestId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  ]
}
