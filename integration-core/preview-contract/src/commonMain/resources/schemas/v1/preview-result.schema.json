{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdds.dev/preview/v1/preview-result.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "success" }, "requestId": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "requestId", "code", "message"],
      "properties": {
        "type": { "const": "failure" },
        "requestId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
