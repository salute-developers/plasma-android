      "enabled": { "base": { "type": "literal", "value": true } },
      "backgroundColor": { "base": { "type": "tokenRef", "tokenId": "color.primary" }, "states": { "pressed": { "type": "literal", "value": "#004FBFFF" } } }
    }
  },
  "example": { "id": "button-basic", "props": { "text": "Continue" } },
  "surface": { "width": 390, "height": 844, "background": "#FFFFFF" }
}
